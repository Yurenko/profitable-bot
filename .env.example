# Copy to .env and fill in. Never commit real keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Password for web dashboard (http://IP:8080). Required if port 8080 is open to the internet.
# Session cookie lasts 24 hours after login.
DASHBOARD_PASSWORD=

# Optional: separate signing secret for session cookies (defaults to DASHBOARD_PASSWORD).
# DASHBOARD_SECRET=

# Telegram alerts (free). Create bot via @BotFather, then get your chat_id.
# 1) @BotFather → /newbot → copy token
# 2) Write /start to your bot
# 3) Open https://api.telegram.org/bot<TOKEN>/getUpdates — find "chat":{"id": YOUR_ID}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
