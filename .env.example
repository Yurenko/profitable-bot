# Copy to .env and fill in. Never commit real keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Password for web dashboard (http://IP:8080). Required if port 8080 is open to the internet.
# Session cookie lasts 24 hours after login.
DASHBOARD_PASSWORD=

# Optional: separate signing secret for session cookies (defaults to DASHBOARD_PASSWORD).
# DASHBOARD_SECRET=
